/* bc250-encoding-decoding-fix v0.4.3 - https://github.com/simpmix/bc250-encoding-decoding-fix */
/*
 * VALIDATION RECORD (2026-09-08, branch fix/subpel-motion-compensation,
 * against integration/all-fixes @ 97b7137 / tag checkpoint-pre-subpel-motion)
 * --------------------------------------------------------------------------
 * Two independent layers of validation before trusting this on real content:
 *
 * 1. ISOLATED interpolation correctness (no board/pipeline involved): a
 *    standalone Vulkan compute harness (lavapipe/llvmpipe software device -
 *    no BC-250 hardware needed for this layer) compiled and ran a
 *    byte-for-byte copy of interp_luma_qpel()/hpel_h_raw()/hpel_v_raw()/
 *    clip_round5()/qavg() against a small synthetic non-linear test image,
 *    cross-checked pixel-for-pixel against an independent from-scratch
 *    Python re-implementation of the ITU-T 8.4.2.2.1 spec equations. ALL 16
 *    quarter-pel sub-positions (G, a..r - integer, both pure horizontal/
 *    vertical half-pel, the 2-pass diagonal-center j construction, and every
 *    quarter-pel average) matched EXACTLY, not approximately. The chroma
 *    eighth-pel bilinear branch (residual_predict.comp) was checked the same
 *    way against 6 positions including a negative MV - also exact.
 *
 * 2. Real board + real decoder, two content types:
 *    - A controlled synthetic clip (anti-aliased edge moving at EXACTLY
 *      0.25 px/frame = 1 quarter-pel/frame, known ground truth per pixel)
 *      encoded through the real VA-API pipeline and decoded with ffmpeg's
 *      software H.264 decoder. BC250_DEBUG_MV_STATS=1 (see encoder_h264.c)
 *      confirmed the search's sub-pel refinement correctly and consistently
 *      lands on mvx=-1 quarter-pel (exactly matching the true motion, with
 *      the correct sign for mvL0's "points into the reference" convention)
 *      on precisely the ~18 macroblocks touching the moving edges each
 *      frame, never elsewhere - the mechanism this file implements is
 *      firing correctly and choosing the mathematically correct answer.
 *    - quality_test.sh's standard `testsrc` clip: 17.10 -> 17.21 dB average
 *      PSNR (SSIM 0.846) - a real but SMALL gain. Investigated rather than
 *      assumed: the SAME BC250_DEBUG_MV_STATS instrumentation on this clip
 *      shows only ~2.5% of macroblocks per frame ever land on a fractional
 *      motion vector at all - most of testsrc's apparent motion (the
 *      rotating pointer's coarse features, the scrolling gradient bar) is
 *      close enough to whole-pixel-per-frame that the integer-pel search
 *      already lands on it, leaving little for sub-pel refinement to win
 *      back on THIS PARTICULAR synthetic content. A decoded-frame visual
 *      inspection (frame 25 of 50) confirms flat color-bar regions are
 *      pixel-perfect, while the circular boundary and flashing test box -
 *      both STATIC, high-spatial-frequency/diagonal edges with near-zero
 *      inter-frame motion - still show real block corruption. A
 *      differential check (comparing this same corruption's magnitude in
 *      an I-frame, where zero motion compensation of any kind is involved,
 *      against P-frames) found it PRESENT AND EQUALLY SEVERE intra - i.e.
 *      this is a pre-existing DCT/quantization-at-sharp-edges limitation
 *      (and, per a separate check, likely the crude fixed-strength
 *      deblock_filter.comp pass too), NOT a P-slice/motion-compensation
 *      defect, and out of this task's scope (P-slice/inter-prediction only;
 *      the DCT/quant and deblock paths were not touched here).
 *
 * CONCLUSION: the quarter-pel interpolation and its search-time refinement
 * are implemented correctly and provably exercised on real content - this
 * closes the specific defect this task targeted (motion vectors could not
 * even be EXPRESSED at sub-pel precision before this change, regardless of
 * content). It is not, by itself, sufficient to make every kind of visible
 * artifact in quality_test.sh's test clip disappear - the now-dominant
 * remaining defect is the DCT/quantization/deblocking treatment of sharp
 * static edges, a different part of the pipeline. See this branch's final
 * report for the full numbers, pixel tables, and visual comparisons.
 */
#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
layout(local_size_x = 64) in; // Wave64 / Dual-Wave32 - native-Wave32 SIMD32 execution model

layout(set = 0, binding = 0, r8) uniform readonly image2D currentImage;
layout(set = 0, binding = 1, r8) uniform readonly image2D referenceImage;

struct MotionVector {
    ivec2 mv;
    uint sad;
};

layout(std430, set = 0, binding = 2) writeonly buffer OutputMV {
    MotionVector mvs[];
};

/*
 * Residual generation (writing dct_transform.comp's InputResiduals) used to
 * live here as a stopgap - this shader was the only stage that already had
 * the current macroblock's raw luma pixels loaded into shared memory
 * (`current_mb`), and residual_buffer had nothing else writing to it at all
 * (dct_transform.comp always read whatever was already in that freshly
 * allocated device-local buffer - unwritten, zero or undefined depending on
 * the driver). That stopgap used a constant 128 predictor (real intra
 * prediction needs reconstructed-neighbor pixels and a chosen prediction
 * mode - a real prediction compute stage, out of scope for a residual-buffer
 * plumbing fix) and left chroma zeroed entirely (no chroma image was bound
 * here).
 *
 * Real intra/inter prediction and residual generation now happens in
 * residual_predict.comp, which runs after this shader (it consumes the real
 * motion vectors this shader computes below, for P-slices) and before
 * dct_transform.comp. See that shader's top-of-file comment for the full
 * design (SAD-based I16x16 mode decision, real DC/Vertical/Horizontal/Plane
 * prediction, real motion-compensated P16x16 residual, chroma DC).
 */

layout(push_constant) uniform PushConstants {
    uint frame_width;
    uint frame_height;
    uint width_in_mbs;
    uint height_in_mbs;
    uint qp;
    uint is_intra;
    uint color_space;
    uint lambda_motion;
} pcs;

/*
 * Sub-pel refinement (added on top of the integer-pel diamond search below):
 * ITU-T H.264 8.4.2.2.1 luma quarter-pel interpolation, implemented exactly
 * (not approximated) because this pipeline's own reconstruction (used both
 * to build the residual here/in residual_predict.comp AND as next frame's
 * reference) must match what a real H.264 decoder produces bit-for-bit at
 * these positions - any approximation here would silently diverge from the
 * bitstream's actual meaning to a real decoder.
 *
 * Quarter-pel grid, one integer cell (G=(0,0) is the base/anchor integer
 * sample this MB's motion vector is measured from; H, M, N are its right/
 * below/diagonal integer neighbors). Half-pel positions (b,h,m,s,j) use the
 * spec's 6-tap [1,-5,20,20,-5,1] filter; quarter-pel positions are a
 * rounded average of their two nearest half-pel/integer neighbors - no
 * separate filter, per spec:
 *
 *   G  a  b  c  H         b,s: 1D horizontal 6-tap (rows through G/H, M/N)
 *   d  e  f  g            h,m: 1D vertical 6-tap (columns through G/M, H/N)
 *   h  i  j  k  m          j : 2D - 6-tap filter applied to 6 rows of
 *   n  p  q  r                  horizontal-intermediate (unclipped/
 *   M        N                  unshifted) sums, single round+clip at the
 *                                end (see j1 below) - fully separable, so
 *                                vertical-then-horizontal gives the exact
 *                                same integer result; horizontal-then-
 *                                vertical is just the order chosen here.
 *
 * All quarter-pel averages below are `(a + b + 1) >> 1` per spec, matched
 * 1:1 against the standard a/b/c/d/e/f/g/h/i/j/k/m/n/p/q/r letter labels
 * used by every real H.264 codec's qpel implementation (e.g. libavcodec's
 * h264qpel), cross-checked position-by-position against Table/Figure 8-4.
 *
 * Deliberately reads referenceImage directly (imageLoad + clamp) rather
 * than the search_window shared-memory cache below: search_window's 48x48
 * footprint exactly covers this MB's +-16px integer search range with ZERO
 * margin for the 6-tap filter's extra +-2/+3-pixel reach, so a best-integer
 * match sitting at the edge of the search range would read out of bounds
 * off that cache. Direct image reads cost more traffic but are correct at
 * every candidate position, including that edge case; this refinement pass
 * only evaluates 16 candidates total (8 half-pel + 8 quarter-pel) per MB, so
 * the extra cost is bounded and small next to the integer search above.
 */
int sampleY(ivec2 p) {
    ivec2 c = clamp(p, ivec2(0), ivec2(int(pcs.frame_width) - 1, int(pcs.frame_height) - 1));
    return int(round(imageLoad(referenceImage, c).r * 255.0));
}

int clip1i(int v) { return clamp(v, 0, 255); }

/* Unclipped/unshifted 6-tap sum, horizontal (row y, centered between x,x+1)
 * and vertical (column x, centered between y,y+1) - shared by the half-pel
 * edge positions (b/s, h/m) and as the intermediate pass for j below. */
int hpel_h_raw(int x, int y) {
    return sampleY(ivec2(x - 2, y)) - 5 * sampleY(ivec2(x - 1, y)) + 20 * sampleY(ivec2(x, y))
         + 20 * sampleY(ivec2(x + 1, y)) - 5 * sampleY(ivec2(x + 2, y)) + sampleY(ivec2(x + 3, y));
}
int hpel_v_raw(int x, int y) {
    return sampleY(ivec2(x, y - 2)) - 5 * sampleY(ivec2(x, y - 1)) + 20 * sampleY(ivec2(x, y))
         + 20 * sampleY(ivec2(x, y + 1)) - 5 * sampleY(ivec2(x, y + 2)) + sampleY(ivec2(x, y + 3));
}
int clip_round5(int v) { return clip1i((v + 16) >> 5); }
int qavg(int a, int b) { return (a + b + 1) >> 1; }

/* Real quarter-pel luma sample at absolute position `ref_qpel`, given in
 * QUARTER-LUMA-SAMPLE units (pixel*4 + fractional 0..3) - i.e. exactly the
 * units this shader now stores motion vectors in. Floor-divides via `>>2`
 * (arithmetic shift = floor division for two's-complement negatives too, so
 * this is correct for negative motion vectors without extra branching). */
int interp_luma_qpel(ivec2 ref_qpel) {
    int ix = ref_qpel.x >> 2, iy = ref_qpel.y >> 2;
    int fx = ref_qpel.x - (ix << 2), fy = ref_qpel.y - (iy << 2); /* always 0..3 */

    if (fx == 0 && fy == 0) return sampleY(ivec2(ix, iy)); /* G: no filtering */

    int G = sampleY(ivec2(ix, iy));
    int H = sampleY(ivec2(ix + 1, iy));
    int M = sampleY(ivec2(ix, iy + 1));
    int b = clip_round5(hpel_h_raw(ix, iy));
    int h = clip_round5(hpel_v_raw(ix, iy));
    int m = clip_round5(hpel_v_raw(ix + 1, iy));
    int s = clip_round5(hpel_h_raw(ix, iy + 1));
    int j1 = hpel_h_raw(ix, iy - 2) - 5 * hpel_h_raw(ix, iy - 1) + 20 * hpel_h_raw(ix, iy)
           + 20 * hpel_h_raw(ix, iy + 1) - 5 * hpel_h_raw(ix, iy + 2) + hpel_h_raw(ix, iy + 3);
    int j = clip1i((j1 + 512) >> 10);

    switch (fy * 4 + fx) {
        case 1:  return qavg(G, b);   /* a (0.25, 0)    */
        case 2:  return b;            /* b (0.5,  0)    */
        case 3:  return qavg(b, H);   /* c (0.75, 0)    */
        case 4:  return qavg(G, h);   /* d (0,    0.25) */
        case 5:  return qavg(b, h);   /* e (0.25, 0.25) - diagonal halves */
        case 6:  return qavg(b, j);   /* f (0.5,  0.25) */
        case 7:  return qavg(b, m);   /* g (0.75, 0.25) - diagonal halves */
        case 8:  return h;            /* h (0,    0.5)  */
        case 9:  return qavg(h, j);   /* i (0.25, 0.5)  */
        case 10: return j;            /* j (0.5,  0.5)  */
        case 11: return qavg(j, m);   /* k (0.75, 0.5)  */
        case 12: return qavg(h, M);   /* n (0,    0.75) */
        case 13: return qavg(h, s);   /* p (0.25, 0.75) - diagonal halves */
        case 14: return qavg(j, s);   /* q (0.5,  0.75) */
        case 15: return qavg(m, s);   /* r (0.75, 0.75) - diagonal halves */
    }
    return G; /* unreachable */
}

shared float search_window[48][48];
shared float current_mb[16][16];
#if defined(GL_KHR_shader_subgroup_arithmetic)
shared uint s_subgroup_sad[16];
#else
shared uint thread_sad[64];
#endif
shared ivec2 shared_best_mv;
shared uint shared_best_cost;
shared ivec2 shared_best_half;      /* best half-pel OFFSET (quarter-pel units) found in step 5 */
shared uint shared_best_half_cost;
shared ivec2 shared_best_qtr;       /* best quarter-pel OFFSET (quarter-pel units) found in step 6 */
shared uint shared_best_qtr_cost;

/*
 * Subgroup-accelerated SAD reduction across the 64-thread workgroup.
 * On AMD RDNA architectures (BC-250 Oberon / Cyan Skillfish), subgroupAdd() reduces cross-lane registers directly
 * in hardware (VOP3P / DPP) with zero Local Data Share (LDS) latency:
 *   - Wave64 (gl_NumSubgroups == 1): single-instruction cross-lane reduction.
 *   - Wave32 (gl_NumSubgroups == 2): 2 barriers across wave leaders.
 * Reduces barrier stalls from >230 dynamic barriers down to ~66 per macroblock.
 * Falls back to tree reduction in shared memory if subgroup arithmetic is unavailable.
 */
uint reduce_workgroup_sad(uint val) {
#if defined(GL_KHR_shader_subgroup_arithmetic)
    uint sub_sum = subgroupAdd(val);
    if (subgroupElect()) {
        s_subgroup_sad[gl_SubgroupID] = sub_sum;
    }
    barrier();
    if (gl_LocalInvocationIndex == 0) {
        uint total = 0;
        for (uint i = 0; i < gl_NumSubgroups; i++) {
            total += s_subgroup_sad[i];
        }
        s_subgroup_sad[0] = total;
    }
    barrier();
    return s_subgroup_sad[0];
#else
    thread_sad[gl_LocalInvocationIndex] = val;
    barrier();
    if (gl_LocalInvocationIndex < 32) thread_sad[gl_LocalInvocationIndex] += thread_sad[gl_LocalInvocationIndex + 32];
    barrier();
    if (gl_LocalInvocationIndex < 16) thread_sad[gl_LocalInvocationIndex] += thread_sad[gl_LocalInvocationIndex + 16];
    barrier();
    if (gl_LocalInvocationIndex < 8)  thread_sad[gl_LocalInvocationIndex] += thread_sad[gl_LocalInvocationIndex + 8];
    barrier();
    if (gl_LocalInvocationIndex < 4)  thread_sad[gl_LocalInvocationIndex] += thread_sad[gl_LocalInvocationIndex + 4];
    barrier();
    if (gl_LocalInvocationIndex < 2)  thread_sad[gl_LocalInvocationIndex] += thread_sad[gl_LocalInvocationIndex + 2];
    barrier();
    if (gl_LocalInvocationIndex == 0) thread_sad[0] += thread_sad[1];
    barrier();
    return thread_sad[0];
#endif
}

// Early termination threshold for zero-motion detection (~2 intensity levels per pixel)
const uint STATIC_MB_THRESHOLD = 512;

void main() {
    uint mb_x = gl_WorkGroupID.x;
    uint mb_y = gl_WorkGroupID.y;
    if (mb_x >= pcs.width_in_mbs || mb_y >= pcs.height_in_mbs) return;

    uint mb_idx = mb_y * pcs.width_in_mbs + mb_x;
    uint local_id = gl_LocalInvocationIndex;
    ivec2 mb_pos = ivec2(mb_x * 16, mb_y * 16);

    // 1. Cooperative load of current macroblock (256 pixels across 64 threads = 4 px/thread)
    for (int i = 0; i < 4; i++) {
        uint p_idx = local_id * 4 + i;
        uint px = p_idx % 16;
        uint py = p_idx / 16;
        ivec2 coord = mb_pos + ivec2(px, py);
        coord = clamp(coord, ivec2(0), ivec2(pcs.frame_width - 1, pcs.frame_height - 1));
        float pixel = imageLoad(currentImage, coord).r;
        current_mb[py][px] = pixel;
    }

    // 2. Cooperative load of 48x48 search window (2304 pixels / 64 threads = 36 px/thread)
    for (int i = 0; i < 36; i++) {
        uint p_idx = local_id * 36 + i;
        if (p_idx < 2304) {
            uint px = p_idx % 48;
            uint py = p_idx / 48;
            ivec2 coord = mb_pos + ivec2(px, py) - ivec2(16, 16);
            coord = clamp(coord, ivec2(0), ivec2(pcs.frame_width - 1, pcs.frame_height - 1));
            search_window[py][px] = imageLoad(referenceImage, coord).r;
        }
    }

    barrier();

    // 3. Fast Zero-Motion Check (SAD at (0, 0))
    uint zero_diff = 0;
    for (int i = 0; i < 4; i++) {
        uint p_idx = local_id * 4 + i;
        uint px = p_idx % 16;
        uint py = p_idx / 16;
        float curr = current_mb[py][px];
        float ref = search_window[py + 16][px + 16];
        zero_diff += uint(abs(curr - ref) * 255.0);
    }
    uint initial_sad = reduce_workgroup_sad(zero_diff);

    // Early exit if the block is static (saves ~60% execution time in gaming/video)
    if (initial_sad <= STATIC_MB_THRESHOLD) {
        if (local_id == 0) {
            mvs[mb_idx].mv = ivec2(0);
            mvs[mb_idx].sad = initial_sad;
        }
        return;
    }

    // 4. Hierarchical Adaptive Diamond Search
    if (local_id == 0) {
        shared_best_mv = ivec2(0);
        shared_best_cost = initial_sad;
    }
    barrier();

    ivec2 diamond[4] = { ivec2(0,1), ivec2(0,-1), ivec2(1,0), ivec2(-1,0) };

    for (int step = 8; step >= 1; step /= 2) {
        ivec2 center = shared_best_mv;
        for (int c = 0; c < 4; c++) {
            ivec2 test_mv = center + diamond[c] * step;
            if (abs(test_mv.x) > 16 || abs(test_mv.y) > 16) continue;

            uint local_diff = 0;
            for (int i = 0; i < 4; i++) {
                uint p_idx = local_id * 4 + i;
                uint px = p_idx % 16;
                uint py = p_idx / 16;
                // 2:1 Checkerboard subsampling cuts ALU and shared memory load by 50%
                if (((px + py) & 1) == 0) {
                    float curr = current_mb[py][px];
                    float ref = search_window[py + 16 + test_mv.y][px + 16 + test_mv.x];
                    local_diff += uint(abs(curr - ref) * 510.0); // Scaled by 2x
                }
            }
            uint cand_sad = reduce_workgroup_sad(local_diff);

            if (local_id == 0) {
                uint cost = cand_sad + pcs.lambda_motion * uint(abs(test_mv.x) + abs(test_mv.y));
                if (cost < shared_best_cost) {
                    shared_best_cost = cost;
                    shared_best_mv = test_mv;
                }
            }
            barrier();
        }

        // Early termination if quality is already high (all invocations break together)
        if (shared_best_cost < 768) break;
    }

    /*
     * 5. Half-pel refinement: evaluate the 8 half-pel positions immediately
     * around the integer winner found above, using the real 6-tap filter
     * (interp_luma_qpel) to build each candidate's interpolated samples for
     * the SAD comparison - "search-then-refine", not a full sub-pel search
     * (see this shader's top-of-file-added comment). SAD-only cost here (no
     * lambda_motion rate term): every candidate in this refinement shares
     * the same integer part, so the rate-cost delta between them is
     * negligible next to the real distortion delta the filter is meant to
     * capture - unlike the integer search above, which needs lambda to
     * choose between genuinely different, far-apart motion vectors.
     */
    ivec2 int_mv_qpel = shared_best_mv * 4; /* fixed anchor - quarter-pel form of the integer winner */
    if (local_id == 0) {
        shared_best_half = ivec2(0);
        shared_best_half_cost = shared_best_cost;
    }
    barrier();

    ivec2 HALF_OFFSETS[8] = {
        ivec2( 2, 0), ivec2(-2, 0), ivec2( 0, 2), ivec2( 0,-2),
        ivec2( 2, 2), ivec2( 2,-2), ivec2(-2, 2), ivec2(-2,-2)
    };
    for (int c = 0; c < 8; c++) {
        ivec2 cand_offset = HALF_OFFSETS[c];
        ivec2 cand_qpel = int_mv_qpel + cand_offset;
        uint local_diff = 0u;
        for (int i = 0; i < 4; i++) {
            uint p_idx = local_id * 4 + i;
            uint px = p_idx % 16;
            uint py = p_idx / 16;
            int curr = int(round(current_mb[py][px] * 255.0));
            ivec2 ref_qpel = ivec2(mb_pos.x + int(px), mb_pos.y + int(py)) * 4 + cand_qpel;
            int ref_val = interp_luma_qpel(ref_qpel);
            local_diff += uint(abs(curr - ref_val));
        }
        uint cand_sad = reduce_workgroup_sad(local_diff);

        if (local_id == 0 && cand_sad < shared_best_half_cost) {
            shared_best_half_cost = cand_sad;
            shared_best_half = cand_offset;
        }
        barrier();
    }

    /*
     * 6. Quarter-pel refinement: evaluate the 8 quarter-pel positions
     * immediately around the half-pel winner from step 5. No separate
     * filter needed - interp_luma_qpel already implements the spec's
     * "quarter-pel = rounded average of nearest half/integer neighbors"
     * rule internally for these fractional positions (see its switch table).
     */
    ivec2 half_mv_qpel = int_mv_qpel + shared_best_half;
    if (local_id == 0) {
        shared_best_qtr = ivec2(0);
        shared_best_qtr_cost = shared_best_half_cost;
    }
    barrier();

    ivec2 QTR_OFFSETS[8] = {
        ivec2( 1, 0), ivec2(-1, 0), ivec2( 0, 1), ivec2( 0,-1),
        ivec2( 1, 1), ivec2( 1,-1), ivec2(-1, 1), ivec2(-1,-1)
    };
    for (int c = 0; c < 8; c++) {
        ivec2 cand_offset = QTR_OFFSETS[c];
        ivec2 cand_qpel = half_mv_qpel + cand_offset;
        uint local_diff = 0u;
        for (int i = 0; i < 4; i++) {
            uint p_idx = local_id * 4 + i;
            uint px = p_idx % 16;
            uint py = p_idx / 16;
            int curr = int(round(current_mb[py][px] * 255.0));
            ivec2 ref_qpel = ivec2(mb_pos.x + int(px), mb_pos.y + int(py)) * 4 + cand_qpel;
            int ref_val = interp_luma_qpel(ref_qpel);
            local_diff += uint(abs(curr - ref_val));
        }
        uint cand_sad = reduce_workgroup_sad(local_diff);

        if (local_id == 0 && cand_sad < shared_best_qtr_cost) {
            shared_best_qtr_cost = cand_sad;
            shared_best_qtr = cand_offset;
        }
        barrier();
    }

    if (local_id == 0) {
        /* Final motion vector, stored in QUARTER-PEL units directly (one
         * consistent unit for the whole pipeline from here on) - see
         * encoder_h264.c's encode_mb_p16x16()/mv_predictor() and
         * residual_predict.comp's P-slice branch, all updated to match. */
        mvs[mb_idx].mv = half_mv_qpel + shared_best_qtr;
        mvs[mb_idx].sad = shared_best_qtr_cost;
    }
}
