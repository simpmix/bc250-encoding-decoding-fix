/* bc250-encoding-decoding-fix v0.4.0 - https://github.com/simpmix/bc250-encoding-decoding-fix */
#version 450
layout(local_size_x = 32) in; // Wave32 aligned - native SIMD32 width for RDNA/Oberon architectures

layout(std430, set = 0, binding = 0) readonly buffer InputResiduals {
    int res[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputCoeffs {
    int coeffs[];
};

/* Compact per-4x4-block DC (position 0 only), one int per block. The CPU needs
 * exactly these values - for the I16x16 luma DC and the chroma DC Hadamards -
 * and nothing else out of `coeffs`, so this is what gets staged to the host
 * instead of the full coefficient buffer: 1/16th the readback. See
 * gpu_compute.h's dc_coeff_buffer. */
layout(std430, set = 0, binding = 2) writeonly buffer OutputDcCoeffs {
    int dc[];
};

layout(push_constant) uniform PushConstants {
    uint frame_width;
    uint frame_height;
    uint width_in_mbs;
    uint height_in_mbs;
    uint qp;
    uint is_intra;
    uint color_space;
    uint lambda_motion;
} pcs;

// H.264 Spec-Compliant 4x4 Core Forward Integer DCT
void forward_4x4(in int in_block[16], out int out_block[16]) {
    int m[16];

    // Horizontal 1D transform
    for (int i = 0; i < 4; i++) {
        int r = i * 4;
        int p0 = in_block[r + 0];
        int p1 = in_block[r + 1];
        int p2 = in_block[r + 2];
        int p3 = in_block[r + 3];

        int a0 = p0 + p3;
        int a1 = p1 + p2;
        int a2 = p1 - p2;
        int a3 = p0 - p3;

        m[r + 0] = a0 + a1;
        m[r + 1] = (a3 << 1) + a2;
        m[r + 2] = a0 - a1;
        m[r + 3] = a3 - (a2 << 1);
    }

    // Vertical 1D transform
    for (int j = 0; j < 4; j++) {
        int p0 = m[0 * 4 + j];
        int p1 = m[1 * 4 + j];
        int p2 = m[2 * 4 + j];
        int p3 = m[3 * 4 + j];

        int a0 = p0 + p3;
        int a1 = p1 + p2;
        int a2 = p1 - p2;
        int a3 = p0 - p3;

        out_block[0 * 4 + j] = a0 + a1;
        out_block[1 * 4 + j] = (a3 << 1) + a2;
        out_block[2 * 4 + j] = a0 - a1;
        out_block[3 * 4 + j] = a3 - (a2 << 1);
    }
}

void main() {
    uint mb_x = gl_WorkGroupID.x;
    uint mb_y = gl_WorkGroupID.y;
    if (mb_x >= pcs.width_in_mbs || mb_y >= pcs.height_in_mbs) return;

    uint block_idx = gl_LocalInvocationIndex;
    if (block_idx >= 24) return; // 16 luma + 4 Cb + 4 Cr blocks

    uint mb_idx = mb_y * pcs.width_in_mbs + mb_x;
    uint global_block_idx = mb_idx * 24 + block_idx;

    int block_data[16];
    for (int i = 0; i < 16; i++) {
        block_data[i] = res[global_block_idx * 16 + i];
    }

    int transformed[16];
    forward_4x4(block_data, transformed);

    for (int i = 0; i < 16; i++) {
        coeffs[global_block_idx * 16 + i] = transformed[i];
    }
    dc[global_block_idx] = transformed[0];
}
